# Signal Configuration (Required)
SIGNAL_SERVICE=signal-cli-rest-api:8080
PHONE_NUMBER=+1234567890
SIGNAL_GROUP_ID=group.aaabccccdddd

# Admins Configuration (Required)
# Configure each admin with indexed environment variables
# ADMIN_1_PHONE, ADMIN_1_MS_EMAIL, ADMIN_2_PHONE, ADMIN_2_MS_EMAIL, etc.
# MS_EMAIL links a Signal admin to the Microsoft organizer account and permits
# that admin's commands to start an Authenticator renewal flow.
ADMIN_1_PHONE=+1234567892
ADMIN_1_MS_EMAIL=parent@example.com
# ADMIN_2_PHONE=+1234567894  # Uncomment to add a second admin
# ADMIN_2_MS_EMAIL=parent@example.com

# Children Configuration (Required)
# Configure each child with indexed environment variables
# CHILD_1_PHONE, CHILD_1_MS_ID, CHILD_1_NAME
# CHILD_2_PHONE, CHILD_2_MS_ID, CHILD_2_NAME
# etc.
CHILD_1_PHONE=+1234567891
CHILD_1_MS_ID=child_microsoft_account_id_1
CHILD_1_NAME=Alice

CHILD_2_PHONE=+1234567893
CHILD_2_MS_ID=child_microsoft_account_id_2
CHILD_2_NAME=Bob

# Playtime Rules (Optional - defaults shown)
# Duration format: 14h, 840m, 13h+30m (also accepts 13h30m)
# Weekly addition to bank: 14 hours
WEEKLY_ADDITION_TIME=14h

# Maximum bank: 42 hours
MAX_BANK_TIME=42h

# Accrued playtime maximum: 3 hours - max continuous play before break needed
ACCRUED_PLAYTIME_MAX_TIME=3h

# Break recovery rate: 3.0 - rate at which non-play time reduces break balance (3x speed)
BREAK_RECOVERY_RATE=3.0

# Blackout Periods
# Use one variable per day, format: "HH:MM-HH:MM,HH:MM-HH:MM"
# Use 00:00-24:00 to block a full day.
BLACKOUT_PERIOD_MON=00:00-08:00,20:30-24:00
BLACKOUT_PERIOD_TUE=00:00-08:00,20:30-24:00
BLACKOUT_PERIOD_WED=00:00-08:00,20:30-24:00
BLACKOUT_PERIOD_THU=00:00-08:00,20:30-24:00
BLACKOUT_PERIOD_FRI=00:00-08:00,20:30-24:00
# BLACKOUT_PERIOD_SAT=
# BLACKOUT_PERIOD_SUN=00:00-24:00  # full-day block example

# General Settings
TZ=America/New_York
DATA_DIR=./data
# Bot language: en (default) or fi
BOT_LANGUAGE=en
